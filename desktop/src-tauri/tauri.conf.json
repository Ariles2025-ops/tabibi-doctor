{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabibi Pro",
  "version": "0.1.0",
  "identifier": "doctor.tabibi.pro",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "sh ../build-dist.sh",
    "beforeBuildCommand": "sh ../build-dist.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tabibi Pro — Cabinet",
        "url": "login.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Medical",
    "shortDescription": "Agenda et gestion de cabinet Tabibi pour médecins.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
