# =====================================================================
# Tabibi.doctor — .gitignore
# =====================================================================
# CRITIQUE : ne JAMAIS committer PII medecins ni secrets.

# --- PII / SCRAPING (RGPD critique) ---
**/medecins*.csv
**/outbound*.csv
**/prospects*.csv
data/private/**
data/cleaned/**
data/raw/**

# --- Secrets / credentials ---
.env
.env.local
.env.*.local
*.pem
*.key
*_secret*
secrets.json
supabase/.env
supabase/.temp/

# --- Backups DB ---
*.sql.gz
*.dump
backup_*.sql
pg_dump_*

# --- Logs / OS / Editor ---
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
~$*

# --- Build / Cache ---
node_modules/
dist/
build/
.netlify/
.cache/

# --- ZIPs de deploy locaux (pas a versionner) ---
tabibi-deploy-*.zip
tabibi-FINAL-*.zip
_deploy_clean/

# --- Tests / coverage ---
coverage/
test-results/
playwright-report/
tests/visual/*.png

# --- PDFs generes en local ---
test-prescriptions/
*_test.pdf

# --- Whitelist : on garde les SVG, JSON brand, fichiers de structure ---
!images/*.svg
!brand/*.json
*.bak*

# --- Capacitor / Mobile ---
# google-services.json contient l'api_key Firebase (clé serveur FCM).
# Repo PUBLIC → ne jamais committer. À placer manuellement sur chaque
# machine de build (voir docs/mobile/FIREBASE_SETUP.md).
android/app/google-services.json
# Signing release (clé d'upload Android) — JAMAIS committer (repo public)
*.jks
*.keystore
keystore.properties
node_modules/
ios/App/Pods/
ios/App/Podfile.lock
ios/App/build/
ios/App/App/Public/
ios/.xcode.env.local
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/release/
www/

# --- Outillage local + spikes (jamais versionnés) ---
# .claude/ : config preview/session Claude Code, propre à chaque machine.
# otp-spike.sh + TEST_booking_e2e.sql : spikes/scripts de test ponctuels.
# *.disabled : fichiers désactivés localement (ex. google-services.json).
.claude/
scripts/otp-spike.sh
migrations/TEST_booking_e2e.sql
android/**/*.disabled

# [Phase 3] Artefacts de build desktop Tauri
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Binaires mobiles — distribués via GitHub Releases, jamais versionnés
*.apk
*.aab

# [Vite 2026-09-09] sortie du build web
dist-web/

# [v2 2026-09-09] sortie du build React
v2/dist/

# [2026-09-09] rapports Lighthouse : sorties de mesure, pas du code (900 Ko)
tests/reports/

# Relique locale de l extraction du JS inline (08/09/2026). Contient l ANCIENNE
# cle anon Supabase (publique par nature, remplacee par sb_publishable_*) et fait
# echouer verifier:cles. Jamais versionnee : ajoutee par erreur le 13/09, retiree.
index-baseline.html
index.html.avant-extraction
.claude/PONT.md
.claude/RETOUR.md
.claude/.pont_vu
.claude/pont-attendre.sh

# --- Repertoire de travail, JAMAIS versionne ---------------------------
# Ajoute le 13/09/2026 apres un `git add -A` qui a emporte 23 fichiers
# etrangers dans une branche de mesure : etat local de wrangler/miniflare,
# corbeille de travail (dont deux archives de 2,8 Mo), et les livraisons
# deposees par l'app Claude dans le dossier du projet.
# La regle qui va avec est dans CLAUDE.md : on ajoute PAR CHEMIN, jamais
# `git add -A` ni `git add .`. Le .gitignore est le filet, pas la regle.
.wrangler/
_to_delete/
Claude outputs/
