{
  "name": "tabibi-doctor",
  "version": "1.0.2",
  "description": "Tabibi — Plateforme médicale algérienne (iOS + Android via Capacitor)",
  "private": true,
  "scripts": {
    "sync": "npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "build:ios": "npx cap build ios",
    "build:android": "npx cap build android",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint js src scripts",
    "verifier:grants": "node scripts/verifier-grants.mjs",
    "lint:dette": "eslint js src scripts -f json | node scripts/compter-dette.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:build": "TABIBI_CIBLE=dist-web playwright test",
    "test": "npm run lint && npm run test:e2e",
    "i18n:verifier": "node scripts/i18n-verifier.mjs",
    "verifier:cles": "node scripts/verifier-cles.mjs",
    "verifier:c1": "node scripts/verifier-c1.mjs",
    "verifier:statuts": "node scripts/verifier-statuts.mjs",
    "verifier:panneaux": "node scripts/verifier-panneaux.mjs",
    "verifier:fuseau": "node scripts/verifier-fuseau.mjs",
    "verifier:rpc": "node scripts/verifier-rpc.mjs",
    "verifier:porte": "node scripts/verifier-porte.mjs",
    "verifier:rpc-passage": "node scripts/verifier-rpc-passage.mjs",
    "verifier:passerelle": "node scripts/verifier-passerelle-chargee.mjs",
    "verifier:proprete": "node scripts/verifier-proprete.mjs",
    "verifier:toutes": "node scripts/verifier-toutes.mjs",
    "verifier:catch": "node scripts/verifier-catch.mjs",
    "porte:fermee": "node scripts/porte.mjs fermee",
    "porte:ouverte": "node scripts/porte.mjs ouverte",
    "build:porte-fermee": "npm run build && npm run porte:fermee",
    "build:porte-ouverte": "npm run build && npm run porte:ouverte"
  },
  "keywords": [
    "tabibi",
    "medical",
    "algeria",
    "capacitor"
  ],
  "author": "Aghiles Haddadene",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
